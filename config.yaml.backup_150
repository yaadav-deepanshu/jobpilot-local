# Job Finder Configuration
# Your profile and search preferences

profile:
  name: "Deepanshu Yadav"
  email: "yaadav.deepanshu@gmail.com"
  phone: "+91 8728081860"
  linkedin_url: "https://linkedin.com/in/yourprofile"
  resume_file: "resume.pdf"

search:
  roles:
    - "Cloud Engineer"
    - "DevOps Engineer"
    - "Site Reliability Engineer"
    - "SRE"
    - "AWS Cloud Engineer"
    - "Azure Cloud Engineer"
    - "GCP Cloud Engineer"
    - "Google Cloud Engineer"
    - "System Engineer"
    - "Platform Engineer"
    - "Infrastructure Engineer"
    - "Cloud Support Engineer"
    - "DevSecOps Engineer"
    - "Cloud Operations Engineer"
    - "Cloud Operations Architect"
    - "Cloud Architect"
    - "DevOps Architect"
    - "Cloud Solutions Architect"
    - "Infrastructure Operations Architect"
    - "Forward Deployed Systems Engineer"
    - "Forward Deployed Engineer"

  keywords:
    # 1. Primary Cloud Providers & Multi-Cloud
    - "cloud"
    - "aws"
    - "amazon web services"
    - "azure"
    - "microsoft azure"
    - "gcp"
    - "google cloud"
    - "google cloud platform"
    - "multi-cloud"
    - "hybrid cloud"

    # 2. AWS Cloud Services (Resume & AWS Certified Developer Stack)
    - "ec2"
    - "s3"
    - "lambda"
    - "iam"
    - "aws sso"
    - "vpc"
    - "route 53"
    - "route53"
    - "cloudwatch"
    - "cloudtrail"
    - "sqs"
    - "sns"
    - "elasticache"
    - "opensearch"
    - "ecs"
    - "ecr"
    - "eks"
    - "codepipeline"
    - "codebuild"
    - "codedeploy"
    - "waf"
    - "kms"
    - "secrets manager"
    - "cloudformation"
    - "alb"
    - "nlb"
    - "elb"

    # 3. Azure Cloud Services & Ecosystem
    - "azure devops"
    - "aks"
    - "azure kubernetes service"
    - "azure active directory"
    - "entra id"
    - "azure blob storage"
    - "azure monitor"
    - "arm templates"
    - "bicep"
    - "azure functions"
    - "azure virtual network"
    - "azure key vault"
    - "application gateway"
    - "azure resource manager"
    - "azure container instances"

    # 4. GCP Cloud Services & Ecosystem
    - "gke"
    - "google kubernetes engine"
    - "cloud run"
    - "cloud functions"
    - "cloud storage"
    - "cloud build"
    - "cloud compute"
    - "google vpc"
    - "cloud pub/sub"
    - "cloud monitoring"
    - "cloud logging"
    - "google cloud armor"

    # 5. Infrastructure as Code (IaC) & Configuration Management
    - "terraform"
    - "terragrunt"
    - "ansible"
    - "ansible playbook"
    - "puppet"
    - "chef"
    - "pulumi"
    - "iac"
    - "infrastructure as code"
    - "packer"
    - "vagrant"
    - "configuration management"

    # 6. Containers, Orchestration & Service Mesh
    - "docker"
    - "docker compose"
    - "dockerfile"
    - "kubernetes"
    - "k8s"
    - "helm"
    - "helm charts"
    - "openshift"
    - "containerd"
    - "podman"
    - "istio"
    - "linkerd"
    - "ingress"
    - "cni"
    - "containerization"

    # 7. CI/CD, Build Automation & GitOps
    - "ci/cd"
    - "cicd"
    - "continuous integration"
    - "continuous deployment"
    - "continuous delivery"
    - "gitops"
    - "jenkins"
    - "github actions"
    - "gitlab"
    - "gitlab ci"
    - "argocd"
    - "flux"
    - "fluxcd"
    - "bitbucket pipelines"
    - "circleci"
    - "build automation"

    # 8. Scripting, Programming & Operating Systems
    - "linux"
    - "ubuntu"
    - "redhat"
    - "centos"
    - "bash"
    - "shell"
    - "shell scripting"
    - "python"
    - "golang"
    - "go"
    - "git"
    - "sql"
    - "powershell"
    - "yaml"
    - "json"

    # 9. Observability, Monitoring, Logging & Telemetry
    - "prometheus"
    - "grafana"
    - "datadog"
    - "elk"
    - "elk stack"
    - "elasticsearch"
    - "logstash"
    - "kibana"
    - "splunk"
    - "new relic"
    - "dynatrace"
    - "opentelemetry"
    - "distributed tracing"
    - "pagerduty"
    - "incident management"

    # 10. Cloud Security, Networking & Access Management
    - "devsecops"
    - "zero trust"
    - "cloud security"
    - "network security"
    - "security groups"
    - "network acls"
    - "nacl"
    - "subnets"
    - "load balancing"
    - "load balancer"
    - "vpn"
    - "dns"
    - "tls"
    - "ssl"
    - "sso"
    - "single sign-on"

    # 11. Site Reliability, Architecture & Platform Engineering
    - "sre"
    - "site reliability"
    - "site reliability engineering"
    - "sli"
    - "slo"
    - "sla"
    - "error budgets"
    - "platform engineering"
    - "internal developer platform"
    - "idp"
    - "microservices"
    - "distributed systems"
    - "high availability"
    - "disaster recovery"
    - "chaos engineering"
    - "cloudops"
    - "sysops"

  location: "Bengaluru"
  remote: true
  hybrid: true

  # Job filters
  max_applicants: 100
  min_experience_years: 0
  max_experience_years: 4

  exclude_keywords:
    - "internship"
    - "volunteer"
    - "unpaid"
    - "part-time"
    - "principal"
    - "director"
    - "manager"
    - "staff"
    - "head of"

  salary_min: 0
  salary_max: 0

platforms:
  linkedin:
    enabled: true
    search_url: "https://www.linkedin.com/jobs/search/"

  indeed:
    enabled: true
    country: "IN"

  naukri:
    enabled: true

  glassdoor:
    enabled: true

  zip_recruiter:
    enabled: true

  google:
    enabled: true

  bayt:
    enabled: true

  wellfound:
    enabled: true

  cutshort:
    enabled: true

  foundit:
    enabled: true

  # Additional Tech, DevOps & Remote Platforms (20+ New Websites)
  instahyre:
    enabled: true
  hirist:
    enabled: true
  remoteok:
    enabled: true
  weworkremotely:
    enabled: true
  devopsjobboard:
    enabled: true
  kubecareers:
    enabled: true
  arc_dev:
    enabled: true
  geektrust:
    enabled: true
  hasjob:
    enabled: true
  otta:
    enabled: true
  dice:
    enabled: true
  simplyhired:
    enabled: true
  hacker_news:
    enabled: true
  levels_fyi:
    enabled: true
  relocate_me:
    enabled: true
  flexjobs:
    enabled: true
  remotive:
    enabled: true
  jobspresso:
    enabled: true
  adzuna:
    enabled: true
  techcareers:
    enabled: true
  devopsroles:
    enabled: true

ai:
  enabled: true
  provider: "anthropic"

  # For Anthropic Claude
  anthropic_api_key: "${CLAUDE_API_KEY}"
  anthropic_model: "claude-3-5-sonnet-20241022"

  # For OpenAI GPT
  openai_api_key: "${OPENAI_API_KEY}"
  openai_model: "gpt-4"

  # Resume tailoring settings
  resume_tailoring:
    enabled: true
    strategy: "keyword_match"

app:
  host: "127.0.0.1"
  port: 5050
  debug: false
  db_file: "jobs.db"

scheduler:
  enabled: true
  scrape_interval_hours: 6
  timezone: "Asia/Kolkata"


