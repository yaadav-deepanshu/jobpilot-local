<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Job Finder{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px 0;
        }
        .container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 30px;
        }
        .navbar-brand {
            font-weight: bold;
        }
        a.back-link {
            color: #667eea;
            text-decoration: none;
            font-weight: 500;
        }
        a.back-link:hover {
            text-decoration: underline;
        }
    </style>
    {% block extra_css %}{% endblock %}
</head>
<body>
    <div class="container mb-3" style="padding: 15px 30px;">
        <div class="d-flex justify-content-between align-items-center">
            <a href="/" class="back-link">🎯 Job Finder</a>
            <div>
                <a href="/" class="btn btn-sm btn-outline-secondary me-2">Dashboard</a>
                <a href="/jobs" class="btn btn-sm btn-outline-primary me-2">All Jobs</a>
                <a href="/portals" class="btn btn-sm btn-outline-info">Portals & Sites</a>
            </div>
        </div>
    </div>

    {% block content %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block extra_js %}{% endblock %}
</body>
</html>
