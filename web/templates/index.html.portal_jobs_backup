    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // --- State ---
        let currentPage = 1;
        let totalPages = 1;
        let totalJobsCount = 0;
        let loadedJobsCount = 0;
        let currentStatusFilter = 'all';
        let currentLocationFilter = 'both';
        let currentSearchQuery = '';
        let scrollMode = 'infinite';
        try {
            scrollMode = localStorage.getItem('job_pagination_mode') || 'infinite';
        } catch(e) {}
        let isLoadingMore = false;
        let hasMorePages = true;
        let intersectionObserver = null;
        let scrapePollInterval = null;
        let timerInterval = null;
        let scrapeStartTime = null;
        let searchTimeout = null;

        function setScrollMode(mode) {
            scrollMode = mode;
            try {
                localStorage.setItem('job_pagination_mode', mode);
            } catch(e) {}
            updateScrollModeButtons();
            loadJobs(true);
        }

        function updateScrollModeButtons() {
            const btnInf = document.getElementById('mode-infinite-btn');
            const btnCls = document.getElementById('mode-classic-btn');
            if (scrollMode === 'infinite') {
                if (btnInf) {
                    btnInf.className = 'btn btn-primary btn-sm fw-semibold';
                }
                if (btnCls) {
                    btnCls.className = 'btn btn-outline-secondary btn-sm';
                }
            } else {
                if (btnInf) {
                    btnInf.className = 'btn btn-outline-secondary btn-sm';
                }
                if (btnCls) {
                    btnCls.className = 'btn btn-primary btn-sm fw-semibold';
                }
            }
        }

        // --- Fetch & Update Stats ---
        function updateStats() {
            const statsUrl = currentHoursFilter ? `/api/stats?hours=${currentHoursFilter}` : '/api/stats';
            fetch(statsUrl)
                .then(r => r.json())
                .then(d => {
                    document.getElementById('stat-total').textContent = d.total_jobs || 0;
                    document.getElementById('stat-new').textContent = d.new || 0;
                    document.getElementById('stat-applied').textContent = d.applied || 0;
                    document.getElementById('stat-saved').textContent = d.saved || 0;

                    const resBadge = document.getElementById('badge-count-researched');
                    if (resBadge) resBadge.textContent = d.researched || 0;

                    const rejBadge = document.getElementById('badge-count-rejected');
                    if (rejBadge) rejBadge.textContent = d.rejected || 0;

                    if (d.by_location) {
                        const bothBadge = document.getElementById('badge-count-both');
                        const blrBadge = document.getElementById('badge-count-bengaluru');
                        const remBadge = document.getElementById('badge-count-remote');
                        if (bothBadge) bothBadge.textContent = d.by_location.both || 0;
                        if (blrBadge) blrBadge.textContent = d.by_location.bengaluru || 0;
                        if (remBadge) remBadge.textContent = d.by_location.remote || 0;
                    }
                })
                .catch(e => console.error('Stats error:', e));
        }

        // --- Location Segregation ---
        function setLocationFilter(mode, btn) {
            currentLocationFilter = mode;
            document.querySelectorAll('#location-toggle-group .btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const badge = document.getElementById('active-loc-badge');
            if (badge) {
                if (mode === 'remote') {
                    badge.textContent = '🌐 Remote Only';
                    badge.className = 'badge bg-success-subtle text-success border border-success-subtle px-2 py-1';
                } else if (mode === 'bengaluru') {
                    badge.textContent = '🏢 Bengaluru Only';
                    badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1';
                } else {
                    badge.textContent = 'Both (All Locations)';
                    badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1';
                }
            }

            updateExportLinks();
            loadJobs(true);
        }

        function updateExportLinks() {
            const locParam = currentLocationFilter !== 'both' ? `?location=${currentLocationFilter}` : '';
            const excelBtn = document.querySelector('a[href*="/export/download/excel"]');
            const pdfBtn = document.querySelector('a[href*="/export/download/pdf"]');
            const htmlBtn = document.querySelector('a[href*="/export/download/html"]');
            if (excelBtn) excelBtn.href = `/export/download/excel${locParam}`;
            if (pdfBtn) pdfBtn.href = `/export/download/pdf${locParam}`;
            if (htmlBtn) htmlBtn.href = `/export/download/html${locParam}`;
        }

        // --- Load Jobs ---
        function loadJobs(reset = true) {
            if (reset) {
                currentPage = 1;
                hasMorePages = true;
                loadedJobsCount = 0;
                const container = document.getElementById('jobs-container');
                if (container) {
                    container.innerHTML = `
                        <div class="text-center py-5 text-muted">
                            <div class="spinner-border text-primary mb-2" role="status"></div>
                            <div>Loading jobs...</div>
                        </div>
                    `;
                }
                const footer = document.getElementById('infinite-scroll-footer');
                if (footer) footer.classList.add('d-none');
                const controls = document.getElementById('pagination-controls');
                if (controls) {
                    controls.classList.add('d-none');
                    controls.classList.remove('d-flex');
                }
            }

            let url = `/api/jobs?page=${currentPage}&per_page=12&status=${currentStatusFilter}&location=${currentLocationFilter}`;
            if (currentHoursFilter) {
                url += `&hours=${currentHoursFilter}`;
            }
            if (currentSearchQuery) {
                url += `&q=${encodeURIComponent(currentSearchQuery)}`;
            }
            fetch(url)
                .then(r => r.json())
                .then(data => {
                    let jobs = data.jobs || [];
                    totalPages = data.pages || 1;
                    totalJobsCount = data.total || 0;
                    loadedJobsCount = jobs.length;

                    renderJobs(jobs, false);

                    if (scrollMode === 'infinite') {
                        const controls = document.getElementById('pagination-controls');
                        if (controls) {
                            controls.classList.add('d-none');
                            controls.classList.remove('d-flex');
                        }

                        const footer = document.getElementById('infinite-scroll-footer');
                        if (footer && jobs.length > 0) {
                            footer.classList.remove('d-none');
                            hasMorePages = currentPage < totalPages;
                            const infoEl = document.getElementById('infinite-scroll-info');
                            if (infoEl) {
                                infoEl.textContent = `Showing ${loadedJobsCount} of ${totalJobsCount} matching jobs (Page ${currentPage} of ${totalPages})`;
                            }

                            const action = document.getElementById('infinite-scroll-action');
                            const endBox = document.getElementById('infinite-scroll-end');
                            const endText = document.getElementById('infinite-scroll-end-text');

                            if (hasMorePages) {
                                if (action) action.classList.remove('d-none');
                                if (endBox) endBox.classList.add('d-none');
                                setupIntersectionObserver();
                            } else {
                                if (action) action.classList.add('d-none');
                                if (endBox) endBox.classList.remove('d-none');
                                if (endText) endText.textContent = `✨ All ${totalJobsCount} jobs loaded (${totalPages} ${totalPages === 1 ? 'page' : 'pages'})`;
                            }
                        } else if (footer) {
                            footer.classList.add('d-none');
                        }
                    } else {
                        const footer = document.getElementById('infinite-scroll-footer');
                        if (footer) footer.classList.add('d-none');
                        renderPagination(data.total, data.page, data.pages);
                    }
                })
                .catch(e => {
                    document.getElementById('jobs-container').innerHTML = `
                        <div class="alert alert-danger">Error loading jobs: ${e}</div>
                    `;
                });
        }

        // --- Infinite Scroll Next Batch ---
        function loadMoreJobs() {
            if (isLoadingMore || !hasMorePages || currentPage >= totalPages) return;
            isLoadingMore = true;

            const loader = document.getElementById('infinite-scroll-loader');
            const action = document.getElementById('infinite-scroll-action');
            if (loader) loader.classList.remove('d-none');
            if (action) action.classList.add('d-none');

            currentPage++;
            let url = `/api/jobs?page=${currentPage}&per_page=12&status=${currentStatusFilter}&location=${currentLocationFilter}`;
            if (currentHoursFilter) {
                url += `&hours=${currentHoursFilter}`;
            }
            if (currentSearchQuery) {
                url += `&q=${encodeURIComponent(currentSearchQuery)}`;
            }

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    const newJobs = data.jobs || [];
                    totalPages = data.pages || 1;
                    totalJobsCount = data.total || 0;

                    if (newJobs.length > 0) {
                        renderJobs(newJobs, true);
                        loadedJobsCount += newJobs.length;
                    }

                    hasMorePages = currentPage < totalPages && newJobs.length > 0;

                    if (loader) loader.classList.add('d-none');
                    const infoEl = document.getElementById('infinite-scroll-info');
                    if (infoEl) {
                        infoEl.textContent = `Showing ${loadedJobsCount} of ${totalJobsCount} matching jobs (Page ${currentPage} of ${totalPages})`;
                    }

                    const endBox = document.getElementById('infinite-scroll-end');
                    const endText = document.getElementById('infinite-scroll-end-text');

                    if (hasMorePages) {
                        if (action) action.classList.remove('d-none');
                        if (endBox) endBox.classList.add('d-none');
                    } else {
                        if (action) action.classList.add('d-none');
                        if (endBox) endBox.classList.remove('d-none');
                        if (endText) endText.textContent = `✨ All ${totalJobsCount} jobs loaded (${totalPages} pages)`;
                        if (intersectionObserver) intersectionObserver.disconnect();
                    }
                    isLoadingMore = false;
                })
                .catch(e => {
                    console.error('Error loading more jobs:', e);
                    if (loader) loader.classList.add('d-none');
                    if (action) action.classList.remove('d-none');
                    isLoadingMore = false;
                });
        }

        function setupIntersectionObserver() {
            if (intersectionObserver) {
                intersectionObserver.disconnect();
            }
            if (scrollMode !== 'infinite') return;

            const sentinel = document.getElementById('infinite-scroll-sentinel');
            if (!sentinel) return;

            if ('IntersectionObserver' in window) {
                intersectionObserver = new IntersectionObserver((entries) => {
                    const entry = entries[0];
                    if (entry && entry.isIntersecting && !isLoadingMore && hasMorePages && currentPage < totalPages) {
                        loadMoreJobs();
                    }
                }, {
                    root: null,
                    rootMargin: '250px',
                    threshold: 0.05
                });
                intersectionObserver.observe(sentinel);
            }
        }

        function renderJobs(jobs, append = false) {
            const container = document.getElementById('jobs-container');
            if (!append && !jobs.length) {
                const hourMsg = currentHoursFilter ? ` in the last ${currentHoursFilter} hours` : '';
                container.innerHTML = `
                    <div class="card p-5 text-center text-muted border-0 shadow-sm" style="border-radius: 14px;">
                        <i class="bi bi-clock-history fs-1 mb-2 text-primary opacity-50"></i>
                        <h5>No jobs found${hourMsg}</h5>
                        <p class="mb-3">${currentHoursFilter ? `No jobs were posted or indexed within the past ${currentHoursFilter} hours. Launch a radar scrape below or view all-time opportunities.` : `Launch a scrape above to discover live jobs from LinkedIn, Indeed, Naukri, Glassdoor, and ZipRecruiter.`}</p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <button class="btn btn-primary btn-sm px-3" onclick="startScrapeWithWindow()">
                                <i class="bi bi-fire me-1"></i> Launch Discovery Scrape (${selectedHours}h)
                            </button>
                            ${currentHoursFilter ? `<button class="btn btn-outline-secondary btn-sm px-3" onclick="clearHoursFilter()"><i class="bi bi-globe me-1"></i> View All Time</button>` : ''}
                        </div>
