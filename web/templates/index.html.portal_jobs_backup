<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JobPilot — Autonomous Career Navigation & Job Discovery Engine</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <script>
        (function() {
            try {
                var theme = localStorage.getItem('jobpilot_theme');
                if (theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch(e) {}
        })();
    </script>

    <style>
        :root {
            --jp-primary: #4f46e5;
            --jp-primary-hover: #4338ca;
            --jp-primary-light: #eef2ff;
            --jp-secondary: #06b6d4;
            --jp-accent: #f43f5e;
            --jp-success: #10b981;
            --jp-warning: #f59e0b;
            --jp-danger: #ef4444;
            --jp-danger-dark: #dc2626;
            --jp-dark: #0f172a;
            --jp-dark-surface: #1e293b;
            --jp-bg: #f8fafc;
            --jp-border: #e2e8f0;
            --jp-card-bg: #ffffff;
            --jp-card-radius: 14px;
            --jp-shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
            --jp-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
            --jp-shadow-lg: 0 12px 30px -4px rgba(15, 23, 42, 0.1);
        }

        /* Dark Mode Theme Tokens */
        [data-theme="dark"] {
            --jp-dark: #f8fafc;
            --jp-dark-surface: #0f172a;
            --jp-bg: #090d16;
            --jp-border: #1e293b;
            --jp-card-bg: #111827;
            --jp-primary-light: #1e1b4b;
            --jp-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
            --jp-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
            --jp-shadow-lg: 0 12px 30px -4px rgba(0, 0, 0, 0.6);
            color-scheme: dark;
        }

        [data-theme="dark"] body {
            background-color: var(--jp-bg);
            color: #e2e8f0;
        }

        [data-theme="dark"] .job-card {
            background: var(--jp-card-bg);
            border-color: var(--jp-border);
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
        }

        [data-theme="dark"] .job-card:hover {
            border-color: #6366f1;
            box-shadow: 0 10px 28px -4px rgba(0, 0, 0, 0.55);
        }

        [data-theme="dark"] .job-title,
        [data-theme="dark"] .text-dark {
            color: #f8fafc !important;
        }

        [data-theme="dark"] .jp-stat-card,
        [data-theme="dark"] .jp-control-card,
        [data-theme="dark"] .nav-filter-card,
        [data-theme="dark"] .location-seg-card,
        [data-theme="dark"] .scrape-monitor {
            background: var(--jp-card-bg);
            border-color: var(--jp-border);
        }

        [data-theme="dark"] .jp-stat-number {
            color: #f8fafc;
        }

        [data-theme="dark"] .bg-light {
            background-color: #1e293b !important;
            color: #cbd5e1 !important;
        }

        [data-theme="dark"] .border {
            border-color: #1e293b !important;
        }

        [data-theme="dark"] .border-top {
            border-top-color: #1e293b !important;
        }

        [data-theme="dark"] .border-bottom {
            border-bottom-color: #1e293b !important;
        }

        [data-theme="dark"] .modal-content {
            background: #111827;
            color: #f8fafc;
            border: 1px solid #334155;
        }

        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select {
            background-color: #1e293b;
            color: #f8fafc;
            border-color: #334155;
        }

        [data-theme="dark"] .form-control:focus,
        [data-theme="dark"] .form-select:focus {
            background-color: #1e293b;
            color: #ffffff;
            border-color: #6366f1;
        }

        [data-theme="dark"] .input-group-text {
            background-color: #1e293b;
            color: #94a3b8;
            border-color: #334155;
        }

        [data-theme="dark"] .job-number-badge {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border-color: #334155;
            color: #a5b4fc;
        }

        [data-theme="dark"] .slider-stop-label {
            background: #1e293b;
            border-color: #334155;
            color: #94a3b8;
        }

        [data-theme="dark"] .slider-stop-label:hover {
            background: #334155;
            color: #f8fafc;
        }

        [data-theme="dark"] .slider-stop-label.active {
            background: #4f46e5;
            color: #ffffff;
            border-color: #6366f1;
        }

        [data-theme="dark"] .text-muted {
            color: #94a3b8 !important;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background-color: var(--jp-bg);
            color: #334155;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        /* Top Navigation Bar */
        .jp-navbar {
            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1030;
        }
        .jp-brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: -0.5px;
        }
        .jp-logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 50%, #06b6d4 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
            font-size: 18px;
        }
        .jp-nav-status {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.25);
            color: #34d399;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .status-pulse-dot {
            width: 7px;
            height: 7px;
            background-color: #10b981;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 8px #10b981;
            animation: pulse-dot 2s infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }

        /* Hero Header Section */
        .jp-hero {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 45%, #312e81 100%);
            color: #ffffff;
            padding: 38px 0 64px 0;
            position: relative;
            overflow: hidden;
        }
        .jp-hero::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, rgba(6, 182, 212, 0.05) 50%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .jp-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            color: #c7d2fe;
            margin-bottom: 12px;
            letter-spacing: 0.3px;
        }
        .jp-hero-title {
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -0.8px;
            line-height: 1.2;
            margin-bottom: 8px;
        }
        .jp-hero-title-accent {
            background: linear-gradient(90deg, #a5b4fc 0%, #67e8f9 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .jp-hero-desc {
            font-size: 15px;
            color: #cbd5e1;
            max-width: 720px;
            line-height: 1.6;
        }
        .jp-spec-pill {
            font-size: 11px;
            font-weight: 600;
            padding: 3px 9px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #e2e8f0;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* Container Overlap */
        .jp-main-container {
            margin-top: -36px;
            padding-bottom: 70px;
            position: relative;
            z-index: 10;
        }

        /* Stats Cards */
        .jp-stat-card {
            background: var(--jp-card-bg);
            border-radius: var(--jp-card-radius);
            box-shadow: var(--jp-shadow);
            border: 1px solid var(--jp-border);
            padding: 20px 22px;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
        }
        .jp-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--jp-shadow-lg);
            border-color: #cbd5e1;
        }
        .jp-stat-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }
        .jp-stat-card.stat-accent-total::after { background: linear-gradient(90deg, #4f46e5, #818cf8); }
        .jp-stat-card.stat-accent-new::after { background: linear-gradient(90deg, #06b6d4, #38bdf8); }
        .jp-stat-card.stat-accent-applied::after { background: linear-gradient(90deg, #10b981, #34d399); }
        .jp-stat-card.stat-accent-saved::after { background: linear-gradient(90deg, #f59e0b, #fbbf24); }

        .jp-stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .jp-stat-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #64748b;
        }
        .jp-stat-icon-bubble {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }
        .bubble-total { background: #eef2ff; color: #4f46e5; }
        .bubble-new { background: #ecfeff; color: #0891b2; }
        .bubble-applied { background: #ecfdf5; color: #059669; }
        .bubble-saved { background: #fffbeb; color: #d97706; }

        .jp-stat-number {
            font-size: 32px;
            font-weight: 800;
            color: var(--jp-dark);
            line-height: 1;
            letter-spacing: -0.5px;
        }
        .jp-stat-subtext {
            font-size: 12px;
            color: #94a3b8;
            margin-top: 6px;
            font-weight: 500;
        }

        /* Time-Window Scraper Command Deck */
        .jp-control-card {
            background: var(--jp-card-bg);
            border-radius: var(--jp-card-radius);
            box-shadow: var(--jp-shadow);
            border: 1px solid var(--jp-border);
            padding: 22px 26px;
            margin-bottom: 22px;
        }
        .custom-range-slider {
            accent-color: var(--jp-primary);
            height: 8px;
            cursor: pointer;
        }
        .slider-stop-label {
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            padding: 3px 9px;
            border-radius: 6px;
            transition: all 0.2s;
            color: #64748b;
            user-select: none;
        }
        .slider-stop-label:hover {
            color: var(--jp-primary);
            background: #eef2ff;
        }
        .slider-stop-label.active {
            color: #ffffff;
            background: var(--jp-primary);
            box-shadow: 0 2px 6px rgba(79, 70, 229, 0.35);
        }

        /* Scraper Monitor Box */
        .scrape-monitor {
            background: #ffffff;
            border: 2px solid var(--jp-primary);
            border-radius: var(--jp-card-radius);
            padding: 22px 26px;
            margin-bottom: 22px;
            box-shadow: 0 10px 30px -5px rgba(79, 70, 229, 0.2);
            animation: fadeIn 0.3s ease;
        }
        .scrape-monitor.is-complete {
            border-color: #10b981;
            background: #f0fdf4;
        }
        .scrape-monitor.is-error {
            border-color: #ef4444;
            background: #fef2f2;
        }

        /* Location Segregation Card */
        .location-segregation-card {
            border: 1px solid var(--jp-border);
            background: #ffffff;
            border-radius: var(--jp-card-radius);
            box-shadow: var(--jp-shadow-sm);
        }
        .location-toggle-group .btn {
            font-size: 13px;
            font-weight: 600;
            padding: 8px 16px;
            border: 1px solid var(--jp-border);
            background: #ffffff;
            color: #475569;
            transition: all 0.2s;
        }
        .location-toggle-group .btn.active {
            background: var(--jp-primary);
            border-color: var(--jp-primary);
            color: #ffffff;
            box-shadow: 0 3px 8px rgba(79, 70, 229, 0.25);
        }

        /* Filter Pills & Buttons */
        .filter-btn {
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #475569;
            cursor: pointer;
            transition: all 0.18s ease;
        }
        .filter-btn.active, .filter-btn:hover {
            background: var(--jp-primary);
            border-color: var(--jp-primary);
            color: #ffffff;
            box-shadow: 0 2px 6px rgba(79, 70, 229, 0.2);
        }
        .filter-btn-researched {
            border-color: #fca5a5 !important;
            color: #dc2626 !important;
            background: #fef2f2 !important;
        }
        .filter-btn-researched.active, .filter-btn-researched:hover {
            background: #dc2626 !important;
            border-color: #dc2626 !important;
            color: #ffffff !important;
            box-shadow: 0 2px 8px rgba(220, 38, 38, 0.3) !important;
        }

        /* Job Cards */
        .job-card {
            background: var(--jp-card-bg);
            border-radius: var(--jp-card-radius);
            box-shadow: var(--jp-shadow);
            border: 1px solid var(--jp-border);
            padding: 24px;
            margin-bottom: 18px;
            position: relative;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .job-card:hover {
            border-color: #a5b4fc;
            box-shadow: 0 10px 30px -4px rgba(79, 70, 229, 0.12);
            transform: translateY(-2px);
        }
        .job-card.is-researched-card {
            border-left: 4px solid #ef4444;
        }

        /* Job Numbering Column & Badge */
        .job-card-inner {
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }
        .job-number-col {
            flex-shrink: 0;
            padding-top: 2px;
        }
        .job-number-badge {
            min-width: 52px;
            height: 52px;
            padding: 0 8px;
            border-radius: 12px;
            background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
            border: 1px solid #e0e7ff;
            color: #4338ca;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(79, 70, 229, 0.05);
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            user-select: none;
        }
        .job-card:hover .job-number-badge {
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
            color: #ffffff;
            border-color: #4338ca;
            box-shadow: 0 6px 18px rgba(79, 70, 229, 0.28);
            transform: translateY(-2px);
        }
        .job-number-prefix {
            font-size: 10px;
            font-weight: 700;
            opacity: 0.65;
            line-height: 1;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }
        .job-card:hover .job-number-prefix {
            opacity: 0.9;
        }
        .job-number-val {
            font-family: 'JetBrains Mono', monospace;
            font-size: 17px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.5px;
        }
        .job-card-main {
            flex-grow: 1;
            min-width: 0;
        }

        /* Re-Searched Card Number Variant */
        .job-card.is-researched-card .job-number-badge {
            background: linear-gradient(135deg, #fff1f2 0%, #fee2e2 100%);
            border-color: #fecdd3;
            color: #e11d48;
            box-shadow: 0 2px 6px rgba(225, 29, 72, 0.08);
        }
        .job-card.is-researched-card:hover .job-number-badge {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: #ffffff;
            border-color: #dc2626;
            box-shadow: 0 6px 18px rgba(239, 68, 68, 0.32);
        }

        @media (max-width: 576px) {
            .job-card-inner {
                gap: 12px;
            }
            .job-number-badge {
                min-width: 42px;
                height: 42px;
                padding: 0 4px;
                border-radius: 10px;
            }
            .job-number-prefix {
                font-size: 9px;
            }
            .job-number-val {
                font-size: 14px;
            }
        }
        .job-title {
            font-size: 19px;
            font-weight: 800;
            color: var(--jp-dark);
            letter-spacing: -0.3px;
            margin-bottom: 4px;
        }
        .company-name {
            font-size: 15px;
            font-weight: 600;
            color: var(--jp-primary);
        }

        /* Badges */
        .badge-platform {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            padding: 5px 10px;
            border-radius: 6px;
            letter-spacing: 0.6px;
        }
        .badge-linkedin { background-color: #0a66c2; color: #ffffff; }
        .badge-indeed { background-color: #003da5; color: #ffffff; }
        .badge-naukri { background-color: #ff6600; color: #ffffff; }
        .badge-glassdoor { background-color: #0caa41; color: #ffffff; }
        .badge-zip_recruiter { background-color: #00a862; color: #ffffff; }
        .badge-google { background-color: #4285f4; color: #ffffff; }
        .badge-bayt { background-color: #1b365d; color: #ffffff; }
        .badge-unknown { background-color: #64748b; color: #ffffff; }

        .status-badge {
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-new { background-color: #e0e7ff; color: #4338ca; }
        .status-applied {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
            color: #ffffff !important;
            font-weight: 800;
            box-shadow: 0 2px 6px rgba(220, 38, 38, 0.35);
            border: 1px solid #b91c1c;
        }
        .status-saved { background-color: #fef3c7; color: #b45309; }
        .status-rejected { background-color: #fee2e2; color: #b91c1c; }

        /* THE RED TAG FOR SEARCHED AGAIN */
        .badge-researched-red {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
            color: #ffffff !important;
            font-weight: 800;
            font-size: 11px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 2px 8px rgba(220, 38, 38, 0.4);
            animation: pulse-red-badge 2s infinite ease-in-out;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        @keyframes pulse-red-badge {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
                transform: scale(1);
            }
            50% {
                box-shadow: 0 0 0 5px rgba(239, 68, 68, 0);
                transform: scale(1.02);
            }
        }

        .badge-search-match-red {
            background: #fef2f2 !important;
            color: #dc2626 !important;
            border: 1px solid #f87171 !important;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 3px 8px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* Infinite Scroll Elements */
        .infinite-scroll-status {
            text-align: center;
            padding: 16px 0 24px 0;
        }
        .infinite-loader-box {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 10px 24px;
            background: #eef2ff;
            border: 1px solid #c7d2fe;
            border-radius: 30px;
            color: var(--jp-primary-hover);
            font-weight: 700;
            font-size: 13px;
            box-shadow: 0 2px 10px rgba(79, 70, 229, 0.12);
        }
        .infinite-end-box {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 24px;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 30px;
            color: #64748b;
            font-size: 13px;
            font-weight: 600;
        }

        /* Floating Back to Top Button */
        #btn-back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1040;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--jp-primary);
            color: #ffffff;
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.45);
            border: none;
            cursor: pointer;
            transition: all 0.25s ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
