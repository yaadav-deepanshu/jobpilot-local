                baseIndex = container.querySelectorAll('.job-card').length;
            } else {
                // In classic pagination or fresh reset, compute based on currentPage (12 per page)
                const perPage = 12;
                baseIndex = Math.max(0, (currentPage - 1) * perPage);
            }

            let html = '';
            jobs.forEach((j, idx) => {
                const jobIndex = baseIndex + idx + 1;
                const plat = (j.platform || 'unknown').toLowerCase();
                const status = (j.status || 'new').toLowerCase();
                const salaryHtml = j.salary ? `<span class="badge bg-light text-dark border me-2"><i class="bi bi-cash me-1"></i>${escapeHtml(j.salary)}</span>` : '';
