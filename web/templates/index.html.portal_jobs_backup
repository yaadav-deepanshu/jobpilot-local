                const locSearch = ((j.location || '') + ' ' + (j.description || '') + ' ' + (j.job_type || '')).toLowerCase();
                const isRemote = locSearch.includes('remote') || locSearch.includes('wfh') || locSearch.includes('work from home');
                const isBlr = (j.location || '').toLowerCase().includes('bengaluru') || (j.location || '').toLowerCase().includes('bangalore');
                let locBadge = '';
                if (isRemote) {
                    locBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle me-1"><i class="bi bi-wifi me-1"></i>Remote</span>';
                } else if (isBlr) {
                    locBadge = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1"><i class="bi bi-building me-1"></i>Bengaluru</span>';
                }

                // RED TAG LOGIC:
                // 1. If job has been re-discovered/searched again (is_researched or search_count > 1)
                // 2. Or if currently matched via active search query
                const isResearched = Boolean(j.is_researched || (j.search_count && j.search_count > 1));
                let redTagHtml = '';
                if (isResearched) {
                    const countTxt = j.search_count && j.search_count > 1 ? ` &bull; ${j.search_count}x` : '';
                    redTagHtml = `<span class="badge-researched-red me-1" title="Discovered again in subsequent searches/scrapes"><i class="bi bi-arrow-repeat me-1"></i> Re-Searched${countTxt}</span>`;
                } else if (currentSearchQuery && currentSearchQuery.length > 0) {
                    redTagHtml = `<span class="badge-search-match-red me-1"><i class="bi bi-search me-1"></i> Search Match</span>`;
                }

                html += `
                    <div class="job-card ${isResearched ? 'is-researched-card' : ''}" id="job-card-${j.id}">
                        <div class="job-card-inner">
                            <!-- Left-Side Opportunity Index Number -->
                            <div class="job-number-col">
                                <div class="job-number-badge" title="Opportunity #${jobIndex}">
                                    <span class="job-number-prefix">#</span>
                                    <span class="job-number-val">${jobIndex}</span>
                                </div>
                            </div>

                            <!-- Main Card Content -->
                            <div class="job-card-main">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div class="d-flex align-items-center flex-wrap gap-1">
                                        <span class="badge-platform badge-${plat}">${plat}</span>
                                        <span class="status-badge status-${status}">${status}</span>
                                        ${locBadge}
                                        ${redTagHtml}
                                        <span class="badge bg-light text-muted border" style="font-size: 11px;">0–4y Exp</span>
                                    </div>
                                    <div class="card-action-block d-flex flex-column align-items-end gap-1 ms-auto">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-danger btn-sm" onclick="searchJobAgain(${j.id}, '${escapeHtml(j.title.replace(/'/g, "\\'"))}')" title="Search for this job role again">
                                                <i class="bi bi-arrow-repeat"></i> Search Again
                                            </button>
                                            ${status !== 'applied' ? `<button class="btn btn-outline-success" onclick="setJobStatus(${j.id}, 'applied')"><i class="bi bi-check2"></i> Mark Applied</button>` : ''}
                                            ${status !== 'saved' ? `<button class="btn btn-outline-warning text-dark" onclick="setJobStatus(${j.id}, 'saved')"><i class="bi bi-bookmark"></i> Save</button>` : ''}
                                            ${status === 'rejected' ? `<button class="btn btn-outline-primary" onclick="setJobStatus(${j.id}, 'new')" title="Restore this job to active feed"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>` : `<button class="btn btn-outline-secondary" onclick="confirmDismissJob(${j.id}, '${escapeHtml(j.title.replace(/'/g, "\\'"))}', '${escapeHtml(j.company.replace(/'/g, "\\'"))}')" title="Dismiss this job"><i class="bi bi-x"></i> Dismiss</button>`}
                                        </div>
                                        <a href="${j.url}" target="_blank" class="btn btn-sm btn-primary w-100 text-center fw-bold shadow-sm btn-apply-direct" style="border-radius: 8px; font-size: 12px; padding: 4px 10px;">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Apply on ${plat.toUpperCase()}
                                        </a>
                                    </div>
                                </div>

                                <div class="job-title">${escapeHtml(j.title)}</div>
                                <div class="company-name mb-2"><i class="bi bi-building me-1"></i>${escapeHtml(j.company)}</div>

                                <div class="job-meta d-flex flex-wrap align-items-center gap-3 mb-3 text-muted small">
                                    <span><i class="bi bi-geo-alt me-1"></i>${escapeHtml(j.location)}</span>
                                    ${salaryHtml}
                                    <span>${datePosted}</span>
                                    ${j.num_applicants ? `<span><i class="bi bi-people me-1"></i>${j.num_applicants} applicants</span>` : ''}
                                    ${j.is_easy_apply ? '<span class="badge bg-info text-dark"><i class="bi bi-lightning-fill"></i> Easy Apply</span>' : ''}
                                </div>

                                ${j.description ? `<p class="text-muted small mb-3" style="line-height: 1.6;">${escapeHtml(j.description)}</p>` : ''}

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top flex-wrap gap-2">
                                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>Indexed: ${j.created_at || 'Recently'}</small>
                                    <span class="badge bg-light text-muted border small"><i class="bi bi-shield-check text-success me-1"></i>Verified 0–4y Role</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            if (append) {
                container.insertAdjacentHTML('beforeend', html);
            } else {
                container.innerHTML = html;
            }
        }

        function renderPagination(total, page, pages) {
            const controls = document.getElementById('pagination-controls');
            if (pages <= 1) {
                controls.classList.add('d-none');
                controls.classList.remove('d-flex');
                return;
            }
            controls.classList.remove('d-none');
            controls.classList.add('d-flex');
            document.getElementById('pagination-info').textContent = `Page ${page} of ${pages} (${total} total jobs)`;
            document.getElementById('btn-prev-page').disabled = page <= 1;
            document.getElementById('btn-next-page').disabled = page >= pages;
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                loadJobs(false);
                window.scrollTo({ top: document.getElementById('jobs-container').offsetTop - 80, behavior: 'smooth' });
            }
        }

        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                loadJobs(false);
                window.scrollTo({ top: document.getElementById('jobs-container').offsetTop - 80, behavior: 'smooth' });
            }
        }

        function setStatusFilter(status, el) {
            currentStatusFilter = status;
            document.querySelectorAll('#status-filter-pills .filter-btn').forEach(b => b.classList.remove('active'));
            if (el) el.classList.add('active');
            loadJobs(true);
        }

        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                currentSearchQuery = document.getElementById('search-input').value.trim();
                loadJobs(true);
            }, 300);
        }

        function clearSearch() {
            const input = document.getElementById('search-input');
            if (input) input.value = '';
            currentSearchQuery = '';
            loadJobs(true);
        }

        // --- Search Job Again Action ---
        function searchJobAgain(jobId, jobTitle) {
            // Mark job as re-searched via API
            fetch(`/api/job/${jobId}/researched`, { method: 'POST' })
                .then(r => r.json())
                .catch(() => {});

            // Put title in search input to filter/highlight matching opportunities
            const input = document.getElementById('search-input');
            if (input) {
                input.value = jobTitle;
                currentSearchQuery = jobTitle;
            }
            updateStats();
            loadJobs(true);

            // Smooth scroll to results
            const container = document.getElementById('jobs-container');
            if (container) {
                window.scrollTo({ top: container.offsetTop - 90, behavior: 'smooth' });
            }
        }

        let pendingDismissJobId = null;

        function confirmDismissJob(jobId, jobTitle, jobCompany) {
            pendingDismissJobId = jobId;
            const titleEl = document.getElementById('dismissModalJobTitle');
            const compEl = document.getElementById('dismissModalJobCompany');
            if (titleEl) titleEl.textContent = jobTitle || 'This Job Role';
            if (compEl) compEl.textContent = jobCompany ? `at ${jobCompany}` : '';

            const modalEl = document.getElementById('dismissConfirmModal');
            if (modalEl && window.bootstrap) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            } else {
                if (confirm(`Dismiss "${jobTitle || 'this job'}"?\nIt will not show up again in your active job feed or subsequent searches.`)) {
                    setJobStatus(jobId, 'rejected');
                    pendingDismissJobId = null;
                }
            }
        }

        function executeDismiss() {
            if (pendingDismissJobId) {
                const modalEl = document.getElementById('dismissConfirmModal');
                if (modalEl && window.bootstrap) {
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                }
                setJobStatus(pendingDismissJobId, 'rejected');
                pendingDismissJobId = null;
            }
        }

        function renumberVisibleJobs() {
            const container = document.getElementById('jobs-container');
            if (!container) return;
            const cards = container.querySelectorAll('.job-card');
            let baseIndex = (currentPage - 1) * 12;
            if (scrollMode === 'infinite') {
                baseIndex = 0;
            }
            cards.forEach((card, idx) => {
                const badgeVal = card.querySelector('.job-number-val');
                if (badgeVal) {
                    badgeVal.textContent = baseIndex + idx + 1;
                }
            });
        }

        function setJobStatus(jobId, newStatus) {
            fetch(`/api/job/${jobId}/status`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            })
            .then(r => r.json())
            .then(() => {
                updateStats();
                if (newStatus === 'rejected') {
                    // Smoothly animate and remove dismissed card from DOM so it doesn't show up again
                    const card = document.getElementById(`job-card-${jobId}`);
                    if (card) {
                        card.style.transition = 'all 0.3s ease';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.96)';
                        setTimeout(() => {
                            card.remove();
                            renumberVisibleJobs();
                            const container = document.getElementById('jobs-container');
                            if (container && container.querySelectorAll('.job-card').length === 0) {
                                loadJobs(false);
                            }
                        }, 300);
                    } else {
                        loadJobs(false);
                    }
                } else if (currentStatusFilter === 'rejected' && newStatus !== 'rejected') {
                    // Restored a job from the Dismissed view
                    const card = document.getElementById(`job-card-${jobId}`);
                    if (card) {
                        card.style.transition = 'all 0.3s ease';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.96)';
                        setTimeout(() => {
                            card.remove();
                            renumberVisibleJobs();
                            const container = document.getElementById('jobs-container');
                            if (container && container.querySelectorAll('.job-card').length === 0) {
                                loadJobs(false);
                            }
                        }, 300);
                    } else {
                        loadJobs(false);
                    }
                } else if (scrollMode === 'infinite' && currentStatusFilter === 'all') {
                    const card = document.getElementById(`job-card-${jobId}`);
                    if (card) {
                        const statusBadge = card.querySelector('.status-badge');
                        if (statusBadge) {
                            statusBadge.className = `status-badge status-${newStatus}`;
                            statusBadge.textContent = newStatus;
                        }
                        const btnGroup = card.querySelector('.btn-group');
                        if (btnGroup) {
                            btnGroup.innerHTML = `
                                <button class="btn btn-outline-danger btn-sm" onclick="searchJobAgain(${jobId}, '')" title="Search for this job role again">
                                    <i class="bi bi-arrow-repeat"></i> Search Again
                                </button>
                                ${newStatus !== 'applied' ? `<button class="btn btn-outline-success" onclick="setJobStatus(${jobId}, 'applied')"><i class="bi bi-check2"></i> Mark Applied</button>` : ''}
                                ${newStatus !== 'saved' ? `<button class="btn btn-outline-warning text-dark" onclick="setJobStatus(${jobId}, 'saved')"><i class="bi bi-bookmark"></i> Save</button>` : ''}
                                <button class="btn btn-outline-secondary" onclick="confirmDismissJob(${jobId}, '', '')"><i class="bi bi-x"></i> Dismiss</button>
                            `;
                        }
                    }
                } else {
                    loadJobs(true);
                }
            })
            .catch(e => alert(`Error updating job: ${e}`));
        }

        // --- Time Window & Scraping Engine ---

        const WINDOW_STOPS = [2, 6, 12, 24];
        let selectedHours = 24;
        let currentHoursFilter = null;

        function updateTimeWindow(val, triggerReload = true) {
            const idx = parseInt(val);
            selectedHours = WINDOW_STOPS[idx] || 24;
            currentHoursFilter = selectedHours;
            const badge = document.getElementById('window-badge');
            if (badge) {
                badge.className = 'badge bg-danger px-2 py-1 fs-6 ms-1 shadow-sm';
                badge.innerHTML = `<i class="bi bi-clock-history me-1"></i>Last ${selectedHours} Hours`;
            }

            // Update active stop label highlighting
            for (let i = 0; i < 4; i++) {
                const el = document.getElementById(`stop-${i}`);
                if (el) {
                    if (i === idx) el.classList.add('active');
                    else el.classList.remove('active');
                }
            }

            const btn = document.getElementById('btn-scrape-window');
            if (btn) btn.innerHTML = `<i class="bi bi-fire me-1"></i> Scrape (${selectedHours}h)`;

            if (triggerReload) {
                currentPage = 1;
                loadJobs(true);
                updateStats();
            }
        }

        function setSliderStop(idx) {
            const slider = document.getElementById('timeWindowSlider');
            if (slider) {
                slider.value = idx;
            }
            updateTimeWindow(idx, true);
        }

        function clearHoursFilter() {
            currentHoursFilter = null;
            const badge = document.getElementById('window-badge');
            if (badge) {
                badge.className = 'badge bg-primary px-2 py-1 fs-6 ms-1';
                badge.textContent = 'All Time';
            }
            for (let i = 0; i < 4; i++) {
                const el = document.getElementById(`stop-${i}`);
                if (el) el.classList.remove('active');
            }
            currentPage = 1;
            loadJobs(true);
            updateStats();
        }

        // --- Theme (Dark / Light Mode) Controller ---
        function toggleDarkMode() {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            const newTheme = isDark ? 'light' : 'dark';
            if (newTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.removeAttribute('data-theme');
            }
            try {
                localStorage.setItem('jobpilot_theme', newTheme);
            } catch(e) {}
            updateThemeToggleUi(newTheme);
        }

        function updateThemeToggleUi(theme) {
            const icon = document.getElementById('theme-toggle-icon');
            const text = document.getElementById('theme-toggle-text');
            if (theme === 'dark') {
                if (icon) icon.className = 'bi bi-sun-fill text-warning';
                if (text) text.textContent = 'Light Mode';
            } else {
                if (icon) icon.className = 'bi bi-moon-stars-fill';
                if (text) text.textContent = 'Dark Mode';
            }
        }

        function startScrapeWithWindow() {
            startScrape(true, selectedHours);
        }

        function startScrape(todayOnly, hours) {
            const btnWindow = document.getElementById('btn-scrape-window');
            const btnAll = document.getElementById('btn-scrape-all');
            if (btnWindow) btnWindow.disabled = true;
            if (btnAll) btnAll.disabled = true;

            const targetHours = hours !== undefined ? hours : (todayOnly ? selectedHours : null);

            const monitor = document.getElementById('scrape-monitor-box');
            monitor.style.display = 'block';
            monitor.className = 'scrape-monitor';

            document.getElementById('monitor-spinner').style.display = 'inline-block';
            document.getElementById('monitor-mode').textContent = targetHours ?
                `🔥 JobPilot Radar: Scanning Last ${targetHours} Hours...` :
                '🔍 JobPilot Radar: Scanning All Time...';
            document.getElementById('monitor-phase').textContent = 'Connecting to multi-platform job feeds...';
            document.getElementById('monitor-progress-bar').className = 'progress-bar progress-bar-striped progress-bar-animated bg-primary';
            document.getElementById('monitor-progress-bar').style.width = '10%';
            document.getElementById('monitor-found-count').textContent = 'Discovered: 0 jobs';
            document.getElementById('monitor-status-text').textContent = 'In progress...';

            scrapeStartTime = Date.now();
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                const elapsed = Math.floor((Date.now() - scrapeStartTime) / 1000);
                const mins = Math.floor(elapsed / 60);
                const secs = elapsed % 60;
                document.getElementById('monitor-timer').textContent = `⏱️ ${mins}:${secs.toString().padStart(2, '0')}`;
            }, 1000);

            const payload = {
                today_only: todayOnly,
                hours: targetHours
            };

            // Trigger backend scrape
            fetch('/api/scrape', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'already_running') {
                    alert('A scrape is already active!');
                }
                pollScrapeStatus();
            })
            .catch(e => {
                alert(`Failed to start scrape: ${e}`);
                stopScrapeUi(false, e);
            });
        }

        function pollScrapeStatus() {
            clearInterval(scrapePollInterval);
            scrapePollInterval = setInterval(() => {
                fetch('/api/scrape-status')
                    .then(r => r.json())
                    .then(st => {
                        document.getElementById('monitor-phase').textContent = st.current_phase || 'Scraping...';
                        document.getElementById('monitor-found-count').textContent = `Discovered: ${st.jobs_found || 0} jobs`;

                        // Progress heuristic
                        let pct = 15;
                        if (st.current_phase.includes('Indeed')) pct = 30;
                        if (st.current_phase.includes('Naukri')) pct = 45;
                        if (st.current_phase.includes('Glassdoor')) pct = 60;
                        if (st.current_phase.includes('Zip_recruiter') || st.current_phase.includes('Ziprecruiter')) pct = 70;
                        if (st.current_phase.includes('Google') || st.current_phase.includes('Bayt')) pct = 80;
                        if (st.current_phase.includes('Filtering')) pct = 90;
                        if (st.current_phase.includes('Saving')) pct = 95;
                        if (st.finished) pct = 100;
                        document.getElementById('monitor-progress-bar').style.width = `${pct}%`;

                        if (st.finished) {
                            clearInterval(scrapePollInterval);
                            clearInterval(timerInterval);
                            stopScrapeUi(true, st.error, st.jobs_saved);
                        }
                    })
                    .catch(() => {});
            }, 1500);
        }

        function stopScrapeUi(isSuccess, errorMsg, savedCount) {
            const btnWindow = document.getElementById('btn-scrape-window');
            const btnAll = document.getElementById('btn-scrape-all');
            if (btnWindow) btnWindow.disabled = false;
            if (btnAll) btnAll.disabled = false;
            document.getElementById('monitor-spinner').style.display = 'none';

            const monitor = document.getElementById('scrape-monitor-box');
            if (errorMsg) {
                monitor.classList.add('is-error');
                document.getElementById('monitor-progress-bar').className = 'progress-bar bg-danger';
                document.getElementById('monitor-status-text').textContent = `Error: ${errorMsg}`;
            } else {
                monitor.classList.add('is-complete');
                document.getElementById('monitor-progress-bar').className = 'progress-bar bg-success';
                document.getElementById('monitor-status-text').textContent = `✅ Complete! ${savedCount || 0} new jobs added.`;
            }

            updateStats();
            loadJobs();

            setTimeout(() => {
                monitor.style.display = 'none';
            }, 12000);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        // --- Back to Top Controller ---
        window.addEventListener('scroll', () => {
            const btn = document.getElementById('btn-back-to-top');
            if (!btn) return;
            if (window.scrollY > 350) {
                btn.classList.add('visible');
            } else {
                btn.classList.remove('visible');
            }
        });

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // --- Init ---
        updateScrollModeButtons();
        updateThemeToggleUi(document.documentElement.getAttribute('data-theme') || 'light');
        updateStats();
        loadJobs(true);

        // Refresh stats periodically
        setInterval(updateStats, 20000);
    </script>
</body>
</html>
